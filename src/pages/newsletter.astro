---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ArticleCards from '../components/ArticleCards.astro';

export const prerender = false;

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const postsPerPage = 10;
const totalPages = Math.ceil(sortedPosts.length / postsPerPage);
const currentPage = parseInt(new URL(Astro.request.url).searchParams.get('page') as string) || 1;
const currentPosts = sortedPosts.slice((currentPage - 1) * postsPerPage, currentPage * postsPerPage);
---

<Layout
  title="Newsletter"
  description='Últimas noticias de este mundo tecnológico'
>
<section class="px-4">
  <div class="space-y-24">
    <div class="newsletter-section py-8 px-4">
      <h1 class="newsletter-title text-4xl font-bold mb-4 text-[var(--text-color-dark)] dark:text-[var(--text-color-light)] items-center justify-center text-center">Suscríbete a la Newsletter</h1>
      <p class="newsletter-description text-lg mb-4 text-[var(--text-color-dark)] dark:text-gray-300">
        Esta es tu newsletter de confianza, en ella podrás leer posts sobre opiniones mías, últimos avances y relatos de la vida de un desarrollador full-stack.
      </p>

      <form id="newsletter-form" class="newsletter-form flex flex-col gap-4 mb-8">
        <label for="newsletter-name" class="sr-only">Nombre</label>
        <input type="text" id="newsletter-name" name="name" placeholder="Introduce tu nombre" required aria-required="true" class="input-field p-2 border rounded">
        <label for="newsletter-email" class="sr-only">Email</label>
        <input type="email" id="newsletter-email" name="email" placeholder="Introduce tu email" required aria-required="true" class="input-field p-2 border rounded">
        <button type="submit" class="submit-button">
          <span class="inline-flex items-center justify-center gap-2 px-6 py-2 text-gray-800 transition bg-gray-100 border border-gray-300 rounded-full dark:bg-gray-800 dark:border-gray-600 dark:text-white text-md hover:bg-[var(--red)] hover:border-[var(--red)] hover:text-white dark:hover:bg-[var(--red)] dark:hover:border-[var(--red)] dark:hover:text-black focus:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-black w-full">
            Suscribirse
          </span>
        </button>
      </form>

      <div id="newsletter-notification" class="notification" role="alert" aria-live="polite"></div>

      <h2 class="text-3xl font-bold mb-4 text-[var(--text-color-dark)] dark:text-[var(--text-color-light)]">Ultimos posts</h2>
      <div class="article-card-grid">
        {currentPosts && currentPosts.length > 0 ? (
          currentPosts.map((post, index) => (
            <ArticleCards
              href={`/newsletter/${post.id.replace(/\.md$/, '')}`}
              title={post.data.title}
              description={post.data.description}
              index={index+1}
              />
          ))
        ) : (
          <p class="text-[var(--text-color-dark)] dark:text-[var(--text-color-light)]">No hay posts.</p>
        )}
      </div>

      <nav class="pagination" aria-label="Paginación">
        {currentPage > 1 && (
          <a href={`?page=${currentPage - 1}`} class="pagination-btn">Anterior</a>
        )}
        <span class="text-[var(--text-color-dark)] dark:text-[var(--text-color-light)]">Página {currentPage} de {totalPages}</span>
        {currentPage < totalPages && (
          <a href={`?page=${currentPage + 1}`} class="pagination-btn">Siguiente</a>
        )}
      </nav>
    </div>
  </div>
</section>
</Layout>

<style>
.article-card-grid {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.newsletter-section {
  padding: 2rem;
  padding-top: 100px;
  border-radius: 12px;
  max-width: 900px;
  margin: 0 auto;
}

.newsletter-title {
  text-align: center;
  color: var(--text-color-dark);
  margin-bottom: 2rem;
}

html.dark .newsletter-title {
  color: var(--text-color-light);
}

.newsletter-description {
  margin-bottom: 2rem;
  color: var(--text-color-dark);
}

html.dark .newsletter-description {
  color: var(--text-color-light);
}

.newsletter-form {
  max-width: 500px;
  margin: 0 auto 2rem;
}

.submit-button {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  width: 100%;
}

.input-field {
  padding: 0.75rem;
  border: 1px solid #ccc;
  border-radius: 8px;
  font-size: 1rem;
  color: var(--text-color-dark);
  background-color: rgba(255, 255, 255, 0.15);
}

html.dark .input-field {
  background-color: rgba(0, 0, 0, 0.2);
  color: var(--text-color-light);
}

.input-field:focus {
  border-color: var(--red);
  outline: none;
  box-shadow: 0 0 0 2px rgba(230, 57, 70, 0.3);
}

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  margin-top: 16px;
}

.pagination-btn {
  padding: 8px 16px;
  background-color: var(--dark-blue);
  color: white;
  border: none;
  border-radius: 9999px;
  text-decoration: none;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.pagination-btn:hover {
  background-color: var(--red);
}

.notification {
  position: fixed;
  top: 20px;
  right: 20px;
  padding: 1rem;
  border-radius: 5px;
  display: none;
  font-size: 1rem;
  z-index: 9999;
  max-width: 350px;
}

.notification.success {
  background-color: #4caf50;
  color: white;
  display: block;
}

.notification.error {
  background-color: #f44336;
  color: white;
  display: block;
}

@media (max-width: 768px) {
  .newsletter-title {
    font-size: 2.5rem;
  }

  .newsletter-description {
    font-size: 1rem;
  }
}
</style>

<script>
document.getElementById('newsletter-form')?.addEventListener('submit', async function (e) {
  e.preventDefault();

  const nameElement = document.getElementById('newsletter-name') as HTMLInputElement | null;
  const emailElement = document.getElementById('newsletter-email') as HTMLInputElement | null;

  if (nameElement && emailElement) {
    const name = nameElement.value.trim();
    const email = emailElement.value.trim();

    try {
      const response = await fetch('/api/subscribe', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ name, email }),
      });

      const data = await response.json();

      if (response.ok) {
        showNotification(data.message || 'Te has suscrito correctamente a la newsletter', 'success');
        (document.getElementById('newsletter-form') as HTMLFormElement).reset();
      } else if (response.status === 409) {
        showNotification(data.message || 'Este correo ya está suscrito a la newsletter', 'error');
      } else {
        showNotification(data.message || 'Hubo un error al suscribirte. Intenta nuevamente', 'error');
      }
    } catch (error) {
      console.error('Error de red:', error);
      showNotification('No se pudo conectar con el servidor. Revisa tu conexión a Internet', 'error');
    }
  }
});

function showNotification(message: string, type: string) {
  const notification = document.getElementById('newsletter-notification');
  if (!notification) return;
  notification.textContent = message;
  notification.className = `notification ${type}`;
  setTimeout(() => {
    notification.className = 'notification';
  }, 5000);
}
</script>
