---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import LinkButton from '../../components/LinkButton.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

export const prerender = true;

const { post } = Astro.props;

if (!post) {
  throw new Error(`Post no encontrado`);
}

const { Content } = await render(post);
const words = post.body ? post.body.split(' ').length : 0;
const readingTime = Math.ceil(words / 200);
---
<Layout title={post.data.title} description={post.data.description}>
  <section class="px-4 py-10">
    <div class="flex justify-center">
      <article class="py-8 px-4 max-w-2xl w-full">
        <h1 class="text-4xl font-bold mb-4 text-center text-[var(--text-color-dark)] dark:text-[var(--text-color-light)] pb-6">{post.data.title}</h1>

        <div class="post-info-container">
          <div class="flex justify-between items-center">
            <p class="text-sm text-left ml-4 text-[var(--text-color-dark)] dark:text-gray-300">
              {readingTime} min · {new Date(post.data.date).toLocaleDateString()}
            </p>
            <button id="shareButton" aria-label="Compartir post" class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13" />
              </svg>
            </button>
          </div>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 ml-4 mt-3">
              {post.data.tags.map((tag) => (
                <span class="px-2 py-1 text-xs font-semibold rounded bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <div id="share-notification" class="notification" role="alert" aria-live="polite"></div>

        {post.data.image && (
          <Image src={post.data.image} alt={post.data.title} class="max-w-full h-auto block mx-auto py-5" loading="lazy" widths={[400, 800]} sizes="(max-width: 640px) 100vw, 640px" />
        )}

        <div class="article-content text-[var(--text-color-dark)] dark:text-[var(--text-color-light)]">
          <Content />
        </div>
        <div class="py-3">
          <LinkButton href="/newsletter">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block mr-1"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Volver a la newsletter
          </LinkButton>
        </div>
      </article>
    </div>
  </section>
</Layout>

<style>
.post-info-container {
  border-top: 1px solid #999a9b;
  border-bottom: 1px solid #999a9b;
  padding: 10px 0;
}

.notification {
  display: none;
  position: fixed;
  top: 20px;
  right: 20px;
  padding: 10px 16px;
  background-color: #4caf50;
  color: white;
  border-radius: 5px;
  z-index: 9999;
}

.notification.show {
  display: block;
}

.notification.error {
  background-color: #f44336;
}
</style>

<script>
  document.getElementById('shareButton')?.addEventListener('click', function() {
    const postUrl = window.location.href;

    navigator.clipboard.writeText(postUrl).then(() => {
      const notification = document.getElementById('share-notification');
      if (!notification) return;
      notification.textContent = 'Enlace copiado al portapapeles';
      notification.classList.remove('error');
      notification.classList.add('show');

      setTimeout(() => {
        notification.classList.remove('show');
      }, 3000);
    }).catch(() => {
      const notification = document.getElementById('share-notification');
      if (!notification) return;
      notification.textContent = 'Error al copiar el enlace';
      notification.classList.add('error', 'show');

      setTimeout(() => {
        notification.classList.remove('show');
      }, 3000);
    });
  });
</script>
