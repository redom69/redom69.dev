---
const url = new URL(Astro.url);
const lang = url.searchParams.get('lang') || 'en';
const translations = await import(`../locales/${lang}.json`);
---

<div class="form-container">
    <form id="contact-form" method="POST" name="formularioContacto">
        <input type="hidden" name="form-name" value="formularioContacto">

        <!-- Honeypot: campo oculto, los bots lo rellenan, los humanos no -->
        <div style="display:none" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field col-12">
            <label for="contact-name">{translations.form.name}</label>
            <input type="text" id="contact-name" name="name" class="input-field p-2 border rounded" placeholder={translations.form.placeholder.name} required aria-required="true" />
        </div>

        <div class="field col-12">
            <label for="contact-email">{translations.form.email}</label>
            <input type="email" id="contact-email" name="email" class="input-field p-2 border rounded" placeholder={translations.form.placeholder.email} required aria-required="true" />
        </div>

        <div class="field col-12">
            <label for="contact-subject">{translations.form.subject}</label>
            <input type="text" id="contact-subject" name="subject" class="input-field p-2 border rounded" placeholder={translations.form.placeholder.subject} required aria-required="true" />
        </div>

        <div class="field col-12">
            <label for="contact-message">{translations.form.message}</label>
            <textarea id="contact-message" name="message" rows="6" class="input-field p-2 border rounded" placeholder={translations.form.placeholder.message} required aria-required="true"></textarea>
        </div>

        <div class="field col-12">
            <button type="submit" class="submit-button">
                <span class="inline-flex items-center justify-center gap-2 px-6 py-2 text-gray-800 transition bg-gray-100 border border-gray-300 rounded-full dark:bg-gray-800 dark:border-gray-600 dark:text-white text-md hover:bg-[var(--red)] hover:border-[var(--red)] hover:text-white dark:hover:bg-[var(--red)] dark:hover:border-[var(--red)] dark:hover:text-black focus:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-black w-full">
                    {translations.form.submit}
                </span>
            </button>
        </div>
    </form>

    <div id="contact-notification" class="notification" role="alert" aria-live="polite" style="display: none;"></div>
</div>

<style>
    .form-container {
        padding: 2rem;
        border-radius: 10px;
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
    }

    .form-container label {
        display: block;
        text-align: left;
        font-weight: bold;
        margin-bottom: 0.5rem;
        padding-bottom: 10px;
        color: var(--text-color-dark);
    }

    html.dark .form-container label {
        color: var(--text-color-light);
    }

    .form-container input, .form-container textarea {
        width: 100%;
        padding: 0.75rem;
        margin-bottom: 1.5rem;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 1rem;
        color: var(--text-color-dark);
        background-color: rgba(255, 255, 255, 0.15);
    }

    html.dark .form-container input,
    html.dark .form-container textarea {
        color: var(--text-color-light);
        background-color: rgba(0, 0, 0, 0.2);
    }

    .submit-button {
        width: 100%;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
    }

    .notification {
        position: fixed;
        top: 20px;
        right: 20px;
        padding: 1rem;
        border-radius: 5px;
        display: none;
        font-size: 1rem;
        z-index: 9999;
        max-width: 350px;
    }

    .notification.success {
        background-color: #4caf50;
        color: white;
    }

    .notification.error {
        background-color: #f44336;
        color: white;
    }
</style>

<script>
document.getElementById('contact-form')?.addEventListener('submit', async function (e) {
    e.preventDefault();

    const nameElement = document.getElementById('contact-name') as HTMLInputElement;
    const emailElement = document.getElementById('contact-email') as HTMLInputElement;
    const subjectElement = document.getElementById('contact-subject') as HTMLInputElement;
    const messageElement = document.getElementById('contact-message') as HTMLTextAreaElement;
    const honeypotElement = document.querySelector('input[name="website"]') as HTMLInputElement;

    if (nameElement && emailElement && subjectElement && messageElement) {
        const name = nameElement.value;
        const email = emailElement.value;
        const subject = subjectElement.value;
        const message = messageElement.value;
        const honeypot = honeypotElement?.value || '';

        try {
            const response = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, email, subject, message, honeypot }),
            });

            if (response.ok) {
                showContactNotification('Correo enviado correctamente', 'success');
                (document.getElementById('contact-form') as HTMLFormElement).reset();
            } else {
                const data = await response.json();
                showContactNotification(data.message || 'Error al enviar el correo', 'error');
            }
        } catch (error) {
            console.error('Error:', error);
            showContactNotification('Error al enviar el correo', 'error');
        }
    }
});

function showContactNotification(message: string, type: string) {
    const notification = document.getElementById('contact-notification');
    if (!notification) return;
    notification.textContent = message;
    notification.classList.remove('success', 'error');
    notification.classList.add(type === 'success' ? 'success' : 'error');
    notification.style.display = 'block';
    setTimeout(() => { notification.style.display = 'none'; }, 5000);
}
</script>
