---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Cancelar Suscripción" description="Cancela tu suscripción a la newsletter.">
  <section class="px-4 py-10">
    <div class="flex justify-center">
      <div class="unsubscribe-section py-8 px-4 max-w-2xl w-full">
        <h1 class="text-3xl font-bold mb-4 text-center text-ink-dark dark:text-ink-light">Cancelar Suscripción</h1>
        <p class="text-lg mb-4 text-center text-ink-dark dark:text-gray-300">
          Si ya no deseas pertenecer a esta comunidad y perderte las últimas noticias, tu te lo pierdes.
        </p>

        <form id="unsubscribe-form" class="flex flex-col gap-4 mb-8 max-w-md mx-auto">
          <label for="unsub-email" class="sr-only">Correo electrónico</label>
          <input
            type="email"
            id="unsub-email"
            name="email"
            placeholder="Tu correo electrónico"
            required
            aria-required="true"
            class="input-field p-2 border rounded"
          />
          <button type="submit" class="submit-button">
            <span class="inline-flex items-center justify-center gap-2 px-6 py-2 text-gray-800 transition bg-gray-100 border border-gray-300 rounded-full dark:bg-gray-800 dark:border-gray-600 dark:text-white text-md hover:bg-brand-red hover:border-brand-red hover:text-white dark:hover:bg-brand-red dark:hover:border-brand-red dark:hover:text-black focus:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-black w-full">
              Desuscribirme
            </span>
          </button>
        </form>

        <div id="unsub-notification" class="notification" role="alert" aria-live="polite" style="display: none;"></div>
      </div>
    </div>
  </section>
</Layout>

<style>
.input-field {
  padding: 0.75rem;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-size: 1rem;
  color: var(--text-color-dark);
  background-color: rgba(255, 255, 255, 0.15);
}

html.dark .input-field {
  background-color: rgba(0, 0, 0, 0.2);
  color: var(--text-color-light);
}

.input-field:focus {
  border-color: var(--red);
  outline: none;
  box-shadow: 0 0 0 2px rgba(230, 57, 70, 0.3);
}

.submit-button {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  width: 100%;
}

.notification {
  position: fixed;
  top: 20px;
  right: 20px;
  padding: 1rem;
  border-radius: 5px;
  font-size: 1rem;
  z-index: 9999;
  max-width: 350px;
}

.notification.success {
  background-color: var(--success);
  color: white;
}

.notification.error {
  background-color: var(--error);
  color: white;
}
</style>

<script>
document.getElementById('unsubscribe-form')?.addEventListener('submit', async function (e) {
  e.preventDefault();

  const emailElement = document.getElementById('unsub-email') as HTMLInputElement | null;
  if (!emailElement) return;

  const email = emailElement.value.trim();

  if (!email) {
    showNotification('Por favor, ingresa tu correo electrónico', 'error');
    return;
  }

  try {
    const response = await fetch('/api/unsubscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });

    const data = await response.json();

    if (data.status === 'success') {
      showNotification('Te has desuscrito exitosamente.', 'success');
      (document.getElementById('unsubscribe-form') as HTMLFormElement).reset();
    } else {
      showNotification(data.message || 'Error al procesar tu solicitud.', 'error');
    }
  } catch {
    showNotification('Hubo un problema al procesar tu solicitud.', 'error');
  }
});

function showNotification(message: string, type: string) {
  const notification = document.getElementById('unsub-notification');
  if (!notification) return;
  notification.textContent = message;
  notification.classList.remove('success', 'error');
  notification.classList.add(type === 'success' ? 'success' : 'error');
  notification.style.display = 'block';

  setTimeout(() => {
    notification.style.display = 'none';
  }, 5000);
}
</script>
