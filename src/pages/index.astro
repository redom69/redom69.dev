---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import SectionContainer from '../components/SectionContainer.astro';
import TitleSection from '../components/TitleSection.astro';
import Hero from '../components/Hero.astro';
import Posts from '../components/Posts.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Mail from '../components/icons/Mail.astro';
import Person from '../components/icons/Person.astro';
import Work from '../components/icons/Work.astro';
import ProjectsIcon from '../components/icons/Projects.astro';
import NewsletterIcon from '../components/icons/NewsletterIcon.astro';

export const prerender = true;
---
<Layout 
  title="Code2Learn"
  description='Explora nuestros servicios de desarrollo web y aprende con los mejores tutoriales full-stack.'
>
  <div class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero />
    </SectionContainer>

    <div class="space-y-24">

      <SectionContainer id="projects" class="section-animate">
        <TitleSection>
          <ProjectsIcon class="size-8" />
          Proyectos
        </TitleSection>
        <Projects/>
      </SectionContainer>

      <SectionContainer id="newsletter" class="section-animate">
        <TitleSection>
          <NewsletterIcon class="size-8" />
          Newsletter
        </TitleSection>
        <Posts/>
      </SectionContainer>

      <SectionContainer id="services" class="section-animate">
        <TitleSection>
          <Work class="size-8" />
          Servicios
        </TitleSection>
        <Services/>
      </SectionContainer>

      <SectionContainer id="about" class="section-animate">
        <TitleSection>
          <Person class="size-8" />
          Sobre mí
        </TitleSection>
        <About/>
      </SectionContainer>

      <SectionContainer id="contacto" class="section-animate">
        <TitleSection>
          <Mail class="size-8" />
          Contacto
        </TitleSection>
        <Contact />
      </SectionContainer>

    </div>
  </div>
</Layout>
