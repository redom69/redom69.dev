---
const personalImageAlt = "Daniel Hernandez";
import Badge from "./Badge.astro";
import LinkedInIcon from "./icons/LinkedIn.astro";
import MailIcon from "./icons/Mail.astro";
import SocialPill from "./SocialPill.astro";
import { Image } from 'astro:assets';
import profileImg from '../../public/profile.webp';

const FALLBACK_PROJECTS_COUNT = 10;

async function getGithubPublicReposCount(): Promise<number> {
  try {
    const response = await fetch('https://api.github.com/users/redom69');
    if (!response.ok) return FALLBACK_PROJECTS_COUNT;
    const { public_repos } = await response.json();
    return typeof public_repos === 'number' ? public_repos : FALLBACK_PROJECTS_COUNT;
  } catch {
    return FALLBACK_PROJECTS_COUNT;
  }
}

const projectsCount = await getGithubPublicReposCount();
---

<div class="max-w-xl mx-auto hero-container">
  <div class="flex flex-col sm:flex-row gap-4 mb-6 items-center">
    <!-- Imagen de perfil -->
    <div class="rounded-full w-24 h-24 overflow-hidden shadow-lg ring-2 ring-brand-red ring-offset-2 ring-offset-transparent">
      <Image
        class="object-cover w-full h-full"
        style={{ objectPosition: "50% 25%" }}
        src={profileImg}
        alt={personalImageAlt}
        width={96}
        height={96}
        loading="eager"
      />
    </div>

    <!-- Botón de "Trabajemos juntos" -->
    <a
      href="https://www.malt.es/profile/danielhernandez4?overview"
      target="_blank"
      rel="noopener"
      class="mt-4 sm:mt-0 flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Trabajemos juntos</Badge>
    </a>
  </div>

  <!-- Título principal -->
  <h1 class="text-center sm:text-left text-5xl sm:text-6xl font-bold tracking-tight text-ink-dark dark:text-ink-light leading-tight">
    Hola, soy <span class="text-brand-red">Daniel</span>
  </h1>

  <!-- Descripción -->
  <p class="mt-6 text-center sm:text-left text-xl text-ink-dark dark:text-gray-300 [&>strong]:text-brand-red [&>strong]:font-semibold leading-relaxed">
    Ingeniero informático y <strong>desarrollador full-stack</strong> con +5 años de experiencia construyendo productos web desde Madrid.
  </p>

  <!-- Stats -->
  <div class="flex gap-8 mt-8 justify-center sm:justify-start">
    <div class="text-center sm:text-left">
      <span class="block text-3xl font-bold text-brand-red">+5</span>
      <span class="text-sm text-gray-500 dark:text-gray-400">años de experiencia</span>
    </div>
    <div class="text-center sm:text-left">
      <span class="block text-3xl font-bold text-brand-red">+{projectsCount}</span>
      <span class="text-sm text-gray-500 dark:text-gray-400">repos públicos en GitHub</span>
    </div>
    <div class="text-center sm:text-left">
      <span class="block text-3xl font-bold text-brand-red">MERN</span>
      <span class="text-sm text-gray-500 dark:text-gray-400">stack principal</span>
    </div>
  </div>

  <!-- Navegación social -->
  <nav class="flex flex-col sm:flex-row gap-4 mt-8 justify-center sm:justify-start">
    <SocialPill href="mailto:sirdanielsan64@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/daniel-hernandez-puerto-57a093194/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>

<style>
  .hero-container {
    animation: fadeInUp 0.6s ease-out both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
